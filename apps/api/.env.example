# Copy this file to .env locally. Never commit .env or real credentials.
# Use a dedicated Moeen database user and a unique local password.
DATABASE_URL=postgresql://moeen_app:***@localhost:5433/moeen
# Required for automated tests. Must point at the dedicated moeen_test
# database with the restricted moeen_test_runner role ONLY (the guard refuses
# every other user/database). The BASE search_path is the shared 'moeen_test'
# schema; scripts/with-test-env.js then rewrites it to the run/worker schema
# (moeen_test_<runId> / moeen_test_<runId>_w<worker>) before jest spawns.
# DATABASE_URL is never used as a substitute for this value.
TEST_DATABASE_URL=postgresql://moeen_test_runner:***@localhost:5433/moeen_test?options=-c%20search_path%3Dmoeen_test
MOEEN_INITIAL_ADMIN_EMAIL=admin@example.com
MOEEN_INITIAL_ADMIN_NAME=مدير معين
MOEEN_INITIAL_ADMIN_PASSWORD=replace-with-a-long-unique-local-password
STAFF_SESSION_TTL_DAYS=7
# Leave unset for direct connections. Set the exact number of trusted reverse-proxy hops in staging/production before relying on client-IP rate limits.
# MOEEN_TRUST_PROXY_HOPS=1
# Paymob is disabled for the cash pilot. Keep values only in local .env after sandbox setup.
PAYMOB_API_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_ID=
PAYMOB_CALLBACK_URL=https://payments.example.com/paymob/webhook

# FCM notifications are opt-in. When false (default), no Firebase credentials
# are required, no outbox rows are created, and no external FCM calls occur.
FCM_NOTIFICATIONS_ENABLED=false
# Required only when FCM_NOTIFICATIONS_ENABLED=true. Keep private credentials
# in the deployment secret store; never commit a service-account JSON file.
# Railway may store FIREBASE_PRIVATE_KEY with literal \\n separators.
# FIREBASE_PROJECT_ID=moeen-firebase-project
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----